/* =============================================================
   AI COURSE MARP THEME
   "Understanding Artificial Intelligence" — Lay People Course
   
   INSTALLATION:
   1. Place this file in your project, e.g. ./themes/ai-course-theme.css
   2. Add to VS Code settings.json:
      "markdown.marp.themes": ["./themes/ai-course-theme.css"]
   3. In each slide deck's front matter:
      ---
      marp: true
      theme: ai-course
      paginate: false
      ---
   ============================================================= */

/* ------------------------------------------------------------- 
   IMPORT FONT
   ------------------------------------------------------------- */
@import url('https://fonts.googleapis.com/css2?family=Calibri:wght@400;700&display=swap');

/* ------------------------------------------------------------- 
   THEME DECLARATION
   ------------------------------------------------------------- */
/* @theme ai-course */

/* ------------------------------------------------------------- 
   CSS CUSTOM PROPERTIES (Color Palette & Typography)
   ------------------------------------------------------------- */
:root {
  /* Colors */
  --dark-bg:   #1A1F2E;   /* deep navy — title slides, headers, footers */
  --mid-bg:    #232A3B;   /* medium navy — content slide backgrounds */
  --card-bg:   #2A3247;   /* card/box background */
  --accent1:   #4EC9C0;   /* teal — primary accent, AI Progress & Policy */
  --accent2:   #F0A500;   /* amber/gold — secondary accent, Alignment & Safety */
  --white:     #FFFFFF;
  --off-white: #E8EDF5;   /* body text on dark backgrounds */
  --muted:     #8D96A8;   /* captions, footers, secondary text */

  /* Category accent colors */
  --cat-progress:    #4EC9C0;  /* AI Progress & Policy — teal */
  --cat-alignment:   #F0A500;  /* Alignment & Safety — amber */
  --cat-social:      #E05C5C;  /* Social Impact — red/coral */
  --cat-cognition:   #7B68EE;  /* Human Cognition — purple */
  --cat-technical:   #5CB85C;  /* Technical Foundations — green */

  /* Typography */
  --font-main: 'Calibri', 'Segoe UI', sans-serif;

  /* Font sizes */
  --fs-course-label:   15pt;
  --fs-section-header: 19pt;
  --fs-main-title:     56pt;
  --fs-subtitle:       27pt;
  --fs-divider-title:  36pt;
  --fs-card-title:     20pt;
  --fs-card-meta:      15pt;
  --fs-body:           17pt;
  --fs-muted:          15pt;
  --fs-footer:         15pt;

  /* Slide dimensions (16:9) */
  --slide-w: 1280px;
  --slide-h: 720px;

  /* Header/footer bar heights */
  --header-h: 68px;   /* 0.85" @ 80px/inch */
  --underline-h: 4px; /* 0.045" */
  --footer-h: 34px;   /* 0.425" */
  --footer-y: calc(var(--slide-h) - var(--footer-h));
}

/* ------------------------------------------------------------- 
   BASE SLIDE — content slides (default)
   ------------------------------------------------------------- */
section {
  font-family: var(--font-main);
  background-color: var(--mid-bg);
  color: var(--off-white);
  width: var(--slide-w);
  height: var(--slide-h);
  padding-top: calc(var(--header-h) + var(--underline-h) + 16px);
  padding-bottom: calc(var(--footer-h) + 8px);
  box-sizing: border-box;
  margin: 0;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

/* Header bar */
section::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: var(--header-h);
  background: var(--dark-bg);
  z-index: 10;
}

/* Header underline (teal by default — override per category class) */
section::after {
  content: '';
  position: absolute;
  top: var(--header-h);
  left: 0;
  width: 100%;
  height: var(--underline-h);
  background: var(--accent1);
  z-index: 10;
}

/* Footer bar */
section > footer,
section .footer {
  position: absolute;
  bottom: 0; left: 0;
  width: 100%;
  height: var(--footer-h);
  background: var(--dark-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-footer);
  color: var(--muted);
  letter-spacing: 0.02em;
  z-index: 10;
}

/* Main content area — sits between header and footer */
/* section > *:not(footer):not(.footer) {
  padding-left: 48px;
  padding-right: 48px;
}

section > *:not(footer):not(.footer):first-child {
  margin-top: calc(var(--header-h) + var(--underline-h) + 16px);
}

section > *:not(footer):not(.footer):last-child {
  margin-bottom: calc(var(--footer-h) + 8px);
} */
/* Headings */
section h1 {
  font-size: 28pt;
  font-weight: 700;
  color: var(--white);
  margin: 0 0 12px 0;
  letter-spacing: 0.01em;
}

section h2 {
  font-size: var(--fs-section-header);
  font-weight: 700;
  color: var(--accent1);
  letter-spacing: 0.04em;
  text-transform: uppercase;
  margin: 0 0 8px 0;
}

section h3 {
  font-size: 18pt;
  font-weight: 700;
  color: var(--off-white);
  margin: 0 0 6px 0;
}

section a {
  color: #4A9EFF;
  text-decoration: underline;
}

/* Body text */
section p {
  font-size: var(--fs-body);
  color: var(--off-white);
  line-height: 1.55;
  margin: 0 0 10px 0;
}

/* Lists */
section ul, section ol {
  font-size: var(--fs-body);
  color: var(--off-white);
  line-height: 1.6;
  padding-left: 1.4em;
  margin: 0 0 10px 0;
}

section li {
  margin-bottom: 4px;
}

/* Strong / emphasis */
section strong {
  color: var(--white);
  font-weight: 700;
}

section em {
  color: var(--accent1);
  font-style: italic;
}

/* Course label (spaced caps, used in header area) */
.course-label {
  font-size: var(--fs-course-label);
  font-weight: 700;
  letter-spacing: 0.25em;
  color: var(--accent1);
  text-transform: uppercase;
}

/* Muted/caption text */
.muted, section small {
  font-size: var(--fs-muted);
  color: var(--muted);
}

/* ------------------------------------------------------------- 
   COURSE LABEL IN HEADER
   (Use an HTML comment directive or a paragraph with class)
   ------------------------------------------------------------- */
section .header-label {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: var(--header-h);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-course-label);
  font-weight: 700;
  letter-spacing: 0.25em;
  color: var(--accent1);
  text-transform: uppercase;
  z-index: 11;
}

/* ------------------------------------------------------------- 
   CATEGORY ACCENT OVERRIDES
   Apply with <!-- _class: content progress --> etc.
   Changes the header underline and h2 color to category accent.
   ------------------------------------------------------------- */

section.progress::after  { background: var(--cat-progress); }
section.progress h2      { color: var(--cat-progress); }
section.progress em      { color: var(--cat-progress); }

section.alignment::after { background: var(--cat-alignment); }
section.alignment h2     { color: var(--cat-alignment); }
section.alignment em     { color: var(--cat-alignment); }

section.social::after    { background: var(--cat-social); }
section.social h2        { color: var(--cat-social); }
section.social em        { color: var(--cat-social); }

section.cognition::after { background: var(--cat-cognition); }
section.cognition h2     { color: var(--cat-cognition); }
section.cognition em     { color: var(--cat-cognition); }

section.technical::after { background: var(--cat-technical); }
section.technical h2     { color: var(--cat-technical); }
section.technical em     { color: var(--cat-technical); }

/* ------------------------------------------------------------- 
   TITLE SLIDE
   Usage: <!-- _class: title -->
   ------------------------------------------------------------- */
section.title {
  background-color: var(--dark-bg);
  justify-content: center;
}

/* Left accent bar */
section.title .accent-bar {
  position: absolute;
  top: 0; left: 0;
  width: 10px;
  height: 100%;
  background: var(--accent1);
  z-index: 5;
}

/* Right decorative panel */
section.title .deco-panel {
  position: absolute;
  top: 0; right: 0;
  width: 280px;
  height: 100%;
  background: #1E2640;
  z-index: 4;
}

/* Decorative circles in right panel */
section.title .deco-panel::before {
  content: '';
  position: absolute;
  width: 220px; height: 220px;
  border-radius: 50%;
  background: rgba(78, 201, 192, 0.25);  /* teal, ~75% transparent */
  top: 60px; right: -60px;
}

section.title .deco-panel::after {
  content: '';
  position: absolute;
  width: 160px; height: 160px;
  border-radius: 50%;
  background: rgba(240, 165, 0, 0.20);   /* amber, ~80% transparent */
  bottom: 120px; right: 40px;
}

/* Third circle via a span inside deco-panel */
section.title .deco-panel .circle3 {
  position: absolute;
  width: 100px; height: 100px;
  border-radius: 50%;
  background: rgba(78, 201, 192, 0.15);
  bottom: 60px; left: -20px;
}

/* Title text block */
section.title .title-content {
  position: absolute;
  left: 48px;
  top: 50%;
  transform: translateY(-50%);
  width: calc(100% - 340px);  /* leave room for right panel */
  z-index: 6;
}

section.title h1 {
  font-size: var(--fs-main-title);
  font-weight: 700;
  color: var(--white);
  margin: 0 0 16px 0;
  line-height: 1.1;
  letter-spacing: 0.01em;
}

section.title h2 {
  font-size: var(--fs-subtitle);
  font-weight: 400;
  color: var(--off-white);
  letter-spacing: 0.02em;
  text-transform: none;
  margin: 0 0 8px 0;
}

/* Bottom strip (replaces footer on title slide) */
section.title .title-footer {
  position: absolute;
  bottom: 0; left: 0;
  width: 100%;
  height: var(--footer-h);
  background: var(--accent1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-footer);
  font-weight: 700;
  color: var(--dark-bg);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  z-index: 10;
}

/* Hide default header/footer on title slide */
section.title::before,
section.title::after {
  display: none;
}

/* ------------------------------------------------------------- 
   SECTION DIVIDER SLIDES
   Usage: <!-- _class: divider progress --> (or alignment, etc.)
   ------------------------------------------------------------- */
section.divider {
  background-color: var(--dark-bg);
  justify-content: center;
}

/* Left accent bar */
section.divider::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 11px;
  height: 100%;
  background: var(--accent1); /* overridden by category class */
  z-index: 5;
}

/* Override left bar color per category */
section.divider.progress::before  { background: var(--cat-progress); }
section.divider.alignment::before { background: var(--cat-alignment); }
section.divider.social::before    { background: var(--cat-social); }
section.divider.cognition::before { background: var(--cat-cognition); }
section.divider.technical::before { background: var(--cat-technical); }

/* Hide the header underline on divider slides */
section.divider::after { display: none; }

section.divider .divider-content {
  position: absolute;
  left: 60px;
  top: 50%;
  transform: translateY(-60%);
  z-index: 6;
}

section.divider h1 {
  font-size: var(--fs-divider-title);
  font-weight: 700;
  color: var(--white);
  letter-spacing: 0.2em;
  text-transform: uppercase;
  margin: 0 0 20px 0;
}

/* Short rule below title */
section.divider .rule {
  width: 160px;
  height: 5px;
  background: var(--accent1);
  margin-bottom: 18px;
}

section.divider.progress  .rule { background: var(--cat-progress); }
section.divider.alignment .rule { background: var(--cat-alignment); }
section.divider.social    .rule { background: var(--cat-social); }
section.divider.cognition .rule { background: var(--cat-cognition); }
section.divider.technical .rule { background: var(--cat-technical); }

/* "SUGGESTED READING" label */
section.divider .reading-label {
  font-size: 16pt;
  font-weight: 700;
  letter-spacing: 0.25em;
  color: var(--accent1);
  text-transform: uppercase;
}

section.divider.progress  .reading-label { color: var(--cat-progress); }
section.divider.alignment .reading-label { color: var(--cat-alignment); }
section.divider.social    .reading-label { color: var(--cat-social); }
section.divider.cognition .reading-label { color: var(--cat-cognition); }
section.divider.technical .reading-label { color: var(--cat-technical); }

/* ------------------------------------------------------------- 
   BOOK CARDS — 2-up layout
   Usage: <!-- _class: book-cards progress --> (or other category)
   ------------------------------------------------------------- */
section.book-cards {
  background-color: var(--mid-bg);
}

section.book-cards .cards-container {
  position: absolute;
  top: calc(var(--header-h) + var(--underline-h) + 12px);
  left: 0;
  right: 0;
  bottom: var(--footer-h);
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 24px;
  padding: 12px 24px 12px 24px;
}

/* Individual book card */
.book-card {
  flex: 1;
  background: var(--card-bg);
  border-radius: 6px;
  box-shadow: 3px 3px 8px rgba(0,0,0,0.20);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* Top color stripe */
.book-card .card-stripe {
  height: 7px;
  background: var(--accent1);
  flex-shrink: 0;
}

section.book-cards.progress  .card-stripe { background: var(--cat-progress); }
section.book-cards.alignment .card-stripe { background: var(--cat-alignment); }
section.book-cards.social    .card-stripe { background: var(--cat-social); }
section.book-cards.cognition .card-stripe { background: var(--cat-cognition); }
section.book-cards.technical .card-stripe { background: var(--cat-technical); }

.book-card .card-body {
  padding: 14px 16px 10px 16px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.book-card .card-title {
  font-size: var(--fs-card-title);
  font-weight: 700;
  color: var(--white);
  margin: 0 0 6px 0;
  line-height: 1.25;
}

.book-card .card-meta {
  font-size: var(--fs-card-meta);
  font-style: italic;
  color: var(--accent1);
  margin: 0 0 8px 0;
}

section.book-cards.progress  .card-meta { color: var(--cat-progress); }
section.book-cards.alignment .card-meta { color: var(--cat-alignment); }
section.book-cards.social    .card-meta { color: var(--cat-social); }
section.book-cards.cognition .card-meta { color: var(--cat-cognition); }
section.book-cards.technical .card-meta { color: var(--cat-technical); }

.book-card .card-rule {
  height: 1px;
  background: rgba(255,255,255,0.1);
  margin-bottom: 8px;
}

.book-card .card-desc {
  font-size: var(--fs-body);
  color: var(--off-white);
  line-height: 1.5;
  flex: 1;
}

/* Category tag chip */
.book-card .card-tag {
  display: inline-block;
  margin-top: 10px;
  padding: 3px 12px;
  border-radius: 20px;
  background: rgba(78, 201, 192, 0.18);
  font-size: 9pt;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--accent1);
  text-transform: uppercase;
  align-self: flex-start;
}

section.book-cards.progress  .card-tag { background: rgba(78,201,192,0.18);  color: var(--cat-progress); }
section.book-cards.alignment .card-tag { background: rgba(240,165,0,0.18);   color: var(--cat-alignment); }
section.book-cards.social    .card-tag { background: rgba(224,92,92,0.18);   color: var(--cat-social); }
section.book-cards.cognition .card-tag { background: rgba(123,104,238,0.18); color: var(--cat-cognition); }
section.book-cards.technical .card-tag { background: rgba(92,184,92,0.18);   color: var(--cat-technical); }

/* ------------------------------------------------------------- 
   COURSE OVERVIEW GRID SLIDE
   Usage: <!-- _class: overview-grid -->
   ------------------------------------------------------------- */
section.overview-grid .grid-container {
  position: absolute;
  top: calc(var(--header-h) + var(--underline-h) + 16px);
  left: 24px;
  right: 24px;
  bottom: calc(var(--footer-h) + 8px);
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: repeat(3, 1fr);
  gap: 14px;
}

.grid-card {
  background: var(--card-bg);
  border-radius: 5px;
  display: flex;
  flex-direction: row;
  overflow: hidden;
  box-shadow: 2px 2px 6px rgba(0,0,0,0.18);
}

.grid-card .grid-number {
  width: 48px;
  background: var(--accent1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18pt;
  font-weight: 700;
  color: var(--dark-bg);
  flex-shrink: 0;
}

.grid-card .grid-text {
  padding: 10px 14px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.grid-card .grid-title {
  font-size: 19pt;
  font-weight: 700;
  color: var(--white);
  margin: 0 0 2px 0;
}

.grid-card .grid-subtitle {
  font-size: 16pt;
  color: var(--muted);
  margin: 0;
}

/* ------------------------------------------------------------- 
   CLOSING SLIDE
   Usage: <!-- _class: closing -->
   Matches title slide style.
   ------------------------------------------------------------- */
section.closing {
  background-color: var(--dark-bg);
  justify-content: center;
}

section.closing::before,
section.closing::after {
  display: none;
}

section.closing .accent-bar {
  position: absolute;
  top: 0; left: 0;
  width: 10px; height: 100%;
  background: var(--accent1);
  z-index: 5;
}

section.closing .deco-panel {
  position: absolute;
  top: 0; right: 0;
  width: 280px; height: 100%;
  background: #1E2640;
  z-index: 4;
}

section.closing .deco-panel::before {
  content: '';
  position: absolute;
  width: 200px; height: 200px;
  border-radius: 50%;
  background: rgba(78,201,192,0.20);
  top: 80px; right: -50px;
}

section.closing .deco-panel::after {
  content: '';
  position: absolute;
  width: 130px; height: 130px;
  border-radius: 50%;
  background: rgba(240,165,0,0.15);
  bottom: 100px; right: 50px;
}

section.closing .closing-content {
  position: absolute;
  left: 60px;
  top: 50%;
  transform: translateY(-55%);
  width: calc(100% - 340px);
  z-index: 6;
}

section.closing h1 {
  font-size: 40pt;
  font-weight: 700;
  color: var(--white);
  margin: 0 0 16px 0;
}

section.closing h2 {
  font-size: 16pt;
  font-weight: 400;
  color: var(--off-white);
  letter-spacing: 0.03em;
  text-transform: none;
  margin: 0;
}

section.closing .closing-footer {
  position: absolute;
  bottom: 0; left: 0;
  width: 100%;
  height: var(--footer-h);
  background: var(--accent1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-footer);
  font-weight: 700;
  color: var(--dark-bg);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  z-index: 10;
}

/* ------------------------------------------------------------- 
   INSTRUCTOR NOTE / CALLOUT BOX
   Usage: wrap text in a <div class="callout"> block
   ------------------------------------------------------------- */
.callout {
  background: rgba(255,255,255,0.05);
  border-left: 3px solid var(--accent2);
  border-radius: 0 4px 4px 0;
  padding: 10px 16px;
  margin: 10px 0;
  font-size: 16pt;
  color: var(--muted);
  font-style: italic;
}

.callout strong {
  color: var(--accent2);
}

/* ------------------------------------------------------------- 
   WARNING BADGE (for flagged books like the Zurita)
   ------------------------------------------------------------- */
.badge-warning {
  display: inline-block;
  background: rgba(224,92,92,0.20);
  color: #E05C5C;
  border-radius: 3px;
  padding: 1px 8px;
  font-size: 14pt;
  font-weight: 700;
  letter-spacing: 0.05em;
  margin-left: 6px;
}

.badge-star {
  display: inline-block;
  background: rgba(240,165,0,0.20);
  color: var(--accent2);
  border-radius: 3px;
  padding: 1px 8px;
  font-size: 14pt;
  font-weight: 700;
  letter-spacing: 0.05em;
  margin-left: 6px;
}

/* ------------------------------------------------------------- 
   PAGINATE (slide numbers) — disabled by default
   Enable with paginate: true in front matter
   ------------------------------------------------------------- */
section.gaia::after {
  font-size: 14pt;
  color: var(--muted);
}
